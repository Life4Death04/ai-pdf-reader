DATABASE_URL="postgresql://user:password@localhost:5432/ai_pdf_reader"

# Local user fallback for development routes that do not use auth yet.
DEFAULT_USER_EMAIL="default@localhost"

# File storage
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB="50"

# Local AI rewrite service
ENABLE_AI_REWRITE="false"
AI_CONCURRENCY="1"
AI_REWRITE_MODE="audiobook"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="phi3"

# Local Piper TTS service
TTS_SERVICE_URL="http://localhost:5050"
TTS_VOICE_ES="es_MX-claude-high"
TTS_VOICE_EN="en_US-amy-medium"
AUDIO_CACHE_DIR="./public/audio-cache"

# Optional S3-compatible storage
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# Observability
ENABLE_MONITORING="false"
LOG_LEVEL="info"
