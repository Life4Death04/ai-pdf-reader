POSTGRES_DB="ai_pdf_reader"
POSTGRES_USER="ai_pdf_reader"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
DATABASE_URL="postgresql://ai_pdf_reader:replace-with-a-long-random-password@db:5432/ai_pdf_reader"

APP_HOST="127.0.0.1"
APP_PORT="3000"

DEFAULT_USER_EMAIL="default@localhost"

UPLOAD_DIR="/app/uploads"
MAX_FILE_SIZE_MB="50"

ENABLE_AI_REWRITE="false"
AI_CONCURRENCY="1"
AI_REWRITE_MODE="audiobook"
OLLAMA_URL="http://ollama:11434"
OLLAMA_MODEL="phi3"
OLLAMA_NO_CLOUD="true"

TTS_SERVICE_URL="http://tts:5050"
TTS_VOICE_ES="es_MX-claude-high"
TTS_VOICE_EN="en_US-amy-medium"
AUDIO_CACHE_DIR="/app/public/audio-cache"

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

ENABLE_MONITORING="false"
LOG_LEVEL="info"
